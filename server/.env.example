NODE_ENV=development
PORT=4000

DATABASE_PATH=./data/mansa.db
# Supabase / Neon pooled PostgreSQL connection string (required after PG migration).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require
# Supabase project credentials (service role key must remain server-side).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=mabdeen-files
UPLOAD_DIR=./uploads

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,https://your-domain.vercel.app,https://your-custom-domain.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

ADMIN_NAME=مدير المنصة
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Parent verification email delivery (Gmail app password or an SMTP-enabled mailbox).
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
