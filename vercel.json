{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/[...path].ts"
    },
    {
      "src": "/(assets|images)/(.*)",
      "dest": "/client/$1/$2"
    },
    {
      "src": "/(manifest\\.webmanifest|registerSW\\.js|sw\\.js|workbox-.*\\.js|favicon\\.ico|robots\\.txt|404\\.html)",
      "dest": "/client/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/client/index.html"
    }
  ]
}
